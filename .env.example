DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/carve_test
BETTER_AUTH_SECRET=replace-with-a-minimum-32-character-random-secret
BETTER_AUTH_URL=http://localhost:3001
APP_ORIGIN=http://localhost:3001
DEV_ADMIN_PASSWORD=carve-local-admin
DEV_IMPERSONATE_USER_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
LOG_LEVEL=info

